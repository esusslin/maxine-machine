# The Odds API key (https://the-odds-api.com)
ODDS_API_KEY=
# Where raw JSON/HTML and the DuckDB warehouse live (default: ./data). Railway: /data
MAXINE_DATA_DIR=./data

# ---- serving plane (server.py) ----
ENV=development
TZ=America/Los_Angeles
APP_DB_PATH=./data/app.db
JWT_SECRET_KEY=<generate>
JWT_EXPIRE_MINUTES=43200
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PHONE=
MIN_EDGE_H2H=0.05
MIN_EDGE_TOTALS=0.05
MIN_EDGE_SPREADS=0.07
MIN_EDGE_REG3=0.05
GAME_DAY_PICKS=true
REG3_FEED=true
ENABLE_JOBS=true
BOOTSTRAP_ON_EMPTY=true
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
